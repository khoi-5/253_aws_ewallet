# Local development only. Copy to .env.local and replace the JWT value.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3307/ewallet_db?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=ewallet_user
DB_PASSWORD=ewallet_pass
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=3600
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Local profile logs verification/reset links instead of sending mail. To exercise
# SMTP, run the prod profile with safe test credentials for the selected provider.
MAIL_DEVELOPMENT_LOG_ENABLED=true
EMAIL_VERIFICATION_MINUTES=1440
PASSWORD_RESET_MINUTES=30
# Supported SMTP selections: ses, resend (used by the prod profile).
EMAIL_PROVIDER=ses
SES_SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=REPLACE_WITH_SES_SMTP_USERNAME
SES_SMTP_PASSWORD=REPLACE_WITH_SES_SMTP_PASSWORD
SES_MAIL_FROM_ADDRESS=noreply@cloud-ewallet.com
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USERNAME=resend
RESEND_SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
RESEND_MAIL_FROM_ADDRESS=noreply@cloud-ewallet.com
VITE_API_BASE_URL=http://localhost:8080
